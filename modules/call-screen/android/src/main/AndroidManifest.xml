<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <application>
    <!--
      Runs ahead of expo-notifications' own service (priority -1) and hands it
      every push except incoming calls, which it shows as a full screen call.
    -->
    <service
      android:name="io.dehub.callscreen.CallMessagingService"
      android:exported="false">
      <intent-filter android:priority="10">
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
    <receiver
      android:name="io.dehub.callscreen.CallActionReceiver"
      android:exported="false" />
  </application>
</manifest>
